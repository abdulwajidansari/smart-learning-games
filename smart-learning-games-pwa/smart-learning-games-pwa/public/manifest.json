  "screenshots": [
    {
      "src": "/screenshots/screenshot-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Smart Learning Games Home Screen"
    },
    {
      "src": "/screenshots/screenshot-2.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Smart Learning Games Mobile View"
    }
  ],
  "shortcuts": [
    {
      "name": "Play Math Master",
      "short_name": "Math",
      "description": "Play Math Master game",
      "url": "/games/math-master",
      "icons": [
        {
          "src": "/icons/math-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Play Word Wizard",
      "short_name": "Words",
      "description": "Play Word Wizard game",
      "url": "/games/word-wizard",
      "icons": [
        {
          "src": "/icons/word-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Profile",
      "short_name": "Profile",
      "description": "View your learning profile",
      "url": "/profile",
      "icons": [
        {
          "src": "/icons/profile-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "iarc_rating_id": "",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "protocol_handlers": [
    {
      "protocol": "web+smartlearning",
      "url": "/open?url=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
